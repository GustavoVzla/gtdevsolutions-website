# Copy to .env.local. Never commit real values.

# Email (Resend, domain gtdevsolutions.com verified)
RESEND_API_KEY=
EMAIL_FROM="GT Dev Solutions <web@gtdevsolutions.com>"
LEADS_INBOX=soluciones@gtdevsolutions.com

# Upstash Redis (rate limits, chat memory, lead backup). REQUIRED for chatbot and auto-reply.
# On Vercel the integration injects KV_REST_API_URL / KV_REST_API_TOKEN (also accepted); elsewhere set one pair by hand.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic API direct (chatbot).
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
CHAT_DAILY_CAP=500

# Extra allowed browser origins, comma-separated (optional)
ALLOWED_ORIGINS=
AUTO_REPLY_ENABLED=false

# Operational alerts (optional; Telegram bot). Without them no alerts are sent.
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=

# Client IP behind a proxy (reverse proxy).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1

